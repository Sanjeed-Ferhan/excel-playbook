# --- Vercel Environment Variables (set these in your Vercel project) ---
# 1) Google OAuth Client ID (public). From Google Cloud Console → Credentials → OAuth 2.0 Client (Web).
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# 2) Only these Google accounts can open the training (comma separated, lower-case).
ALLOWED_EMAILS=you@gmail.com,student1@gmail.com,student2@gmail.com

# 3) Random secret used to sign the login cookie. Generate any long random string.
#    Example: openssl rand -hex 32
APP_SECRET=change-this-to-a-long-random-string
